{
    "version": 2,
    "builds": [
        {
            "src": "backend/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/server.js"
        },
        {
            "src": "/analyze",
            "dest": "backend/server.js"
        },
        {
            "src": "/cases(.*)",
            "dest": "backend/server.js"
        },
        {
            "src": "/auth/(.*)",
            "dest": "backend/server.js"
        },
        {
            "src": "/patients(.*)",
            "dest": "backend/server.js"
        },
        {
            "src": "/analytics",
            "dest": "backend/server.js"
        },
        {
            "src": "/audit-log",
            "dest": "backend/server.js"
        },
        {
            "src": "/admin/(.*)",
            "dest": "backend/server.js"
        },
        {
            "src": "/reference/(.*)",
            "dest": "backend/server.js"
        },
        {
            "src": "/second-opinion",
            "dest": "backend/server.js"
        },
        {
            "src": "/health",
            "dest": "backend/server.js"
        },
        {
            "src": "/i18n/(.*)",
            "dest": "frontend/i18n/$1"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/$1"
        }
    ]
}